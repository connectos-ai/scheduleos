# ScheduleOS local development example
# Copy values into a private .env file when needed. Do not commit .env.

# Keep localhost for local development. NODE_ENV=production rejects public
# bind hosts such as 0.0.0.0 unless authentication is configured.
# Production public bind hosts also require request throttling.
# Production public bind hosts require persisted request throttling.
# Production public bind hosts require durable storage.
SCHEDULEOS_HOST=127.0.0.1
SCHEDULEOS_PORT=8787

# Optional local API key for development-only static auth.
# Use a generated secret in real deployments; NODE_ENV=production rejects
# the default development value below.
SCHEDULEOS_API_KEY=dev_scheduleos_change_me
SCHEDULEOS_API_ROLE=EDITOR
SCHEDULEOS_TENANT_ID=tenant_demo
SCHEDULEOS_WORKSPACE_ID=workspace_demo
SCHEDULEOS_USER_ID=user_jordan
# Production static API-key auth requires explicit non-demo IDs.

# Optional browser session-cookie transport foundation.
# Keep disabled unless you are testing cookie auth behind trusted local TLS/proxy setup.
# When NODE_ENV=production and cookie auth is enabled, Secure cookies are required.
SCHEDULEOS_AUTH_SESSION_COOKIE=false
SCHEDULEOS_AUTH_SESSION_COOKIE_SECURE=false
# Optional local password-reset bootstrap helper.
# Keep false outside private local development; NODE_ENV=production rejects true.
SCHEDULEOS_AUTH_PASSWORD_RESET_RETURN_TOKEN=false
SCHEDULEOS_AUTH_PASSWORD_RESET_TTL_MS=1800000

# Optional local JSON persistence path.
# Keep real local data out of git.
SCHEDULEOS_STORAGE_PATH=.local/scheduleos.dev.json

# Optional local/self-host request throttling.
# Process-local by default. Set persisted=true only with storage configured.
# Persisted mode stores hashed authenticated request keys scoped by tenant/workspace/user.
# Set trusted proxy header only behind a proxy you control that strips spoofed
# forwarding headers before adding its own client IP value.
# Use shared edge or distributed rate limits for production.
SCHEDULEOS_RATE_LIMIT_WINDOW_MS=60000
SCHEDULEOS_RATE_LIMIT_MAX_REQUESTS=120
SCHEDULEOS_RATE_LIMIT_PERSISTED=false
SCHEDULEOS_RATE_LIMIT_TRUSTED_PROXY_HEADER=

# Optional local/self-host import-abuse alert thresholds.
# When configured, GET /api/import-abuse/summary reports REVIEW_REQUIRED
# when denied import events or denied rows meet these thresholds.
# Hosted alert delivery and dashboards are still production release blockers.
SCHEDULEOS_IMPORT_ABUSE_ALERT_DENIED_EVENTS=
SCHEDULEOS_IMPORT_ABUSE_ALERT_DENIED_ROWS=

# Optional local/self-host public-event delivery summary alert thresholds.
# When configured, GET /api/events/webhook-deliveries/summary reports
# REVIEW_REQUIRED when failed or retryable failed delivery attempts meet thresholds.
# Hosted delivery dashboards and alert routing remain production release blockers.
SCHEDULEOS_PUBLIC_EVENT_DELIVERY_ALERT_FAILED_ATTEMPTS=
SCHEDULEOS_PUBLIC_EVENT_DELIVERY_ALERT_RETRYABLE_FAILED_ATTEMPTS=
SCHEDULEOS_PUBLIC_EVENT_SUBSCRIPTION_HEALTH_ALERT_FAILING_SUBSCRIPTIONS=
SCHEDULEOS_PUBLIC_EVENT_SUBSCRIPTION_HEALTH_ALERT_EXHAUSTED_SUBSCRIPTIONS=
SCHEDULEOS_PUBLIC_EVENT_SUBSCRIPTION_HEALTH_ALERT_NEVER_DELIVERED_SUBSCRIPTIONS=

# PostgreSQL migration target for development.
# The default migration command is dry-run unless using db:postgres:migrate:apply.
SCHEDULEOS_POSTGRES_URL=postgres://scheduleos:scheduleos@localhost:5432/scheduleos

# Guarded live test database. The database name must include scheduleos_test.
SCHEDULEOS_TEST_POSTGRES_URL=postgres://scheduleos:scheduleos@localhost:55432/scheduleos_test
